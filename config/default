environment:
    env_name: gridworld
    reward_scheme: coverage
    base_station: False
    fov: 8
    max_steps: 1000
    size: 25
    num_agents: 5
    cr: 10

training:
    module_file: cnn_2conv2linear.py
    num_episodes: 10000
    target_reward: 10000
    gamma: 0.90
    lr: 0.0001
    grad_clip: 1.0
    train_batch_size: 10000
    num_epochs: 5
    minibatch_size: 1000
    l2_regularization: 0.0001
    lambda_: 0.90
    entropy_coeff_schedule: [[0, 0.01], [5_000_000, 0.01], [15_000_000, 0.005], [22_000_000, 0.00001]]

testing:
    num_episodes_per_map: 10
    seed: 42
    explore: True
    render: True
    model_version: v4
    checkpoint: -1
