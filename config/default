environment:
    env_name: gridworld
    reward_scheme: coverage
    base_station: False
    fov: 4
    max_steps: 1000
    size: 25
    num_agents: 5
    cr: 10

training:
    module_file: cnn_2conv1linear.py
    num_episodes: 25000
    target_reward: 650
    gamma: 0.90
    lr: 0.0003
    grad_clip: 1.0
    train_batch_size: 32000
    num_epochs: 8
    minibatch_size: 4000
    l2_regularization: 0.0001
    lambda_: 0.95
    entropy_coeff_schedule: [[0, 0.01], [10_000_000, 0.01], [20_000_000, 0.008], [30_000_000, 0.005]]

testing:
    num_episodes_per_map: 10
    seed: 42
    explore: False
    render: True
    model_version: v2
    checkpoint: -1
