environment:
    env_name: gridworld
    reward_scheme: coverage
    base_station: false
    fov: 8
    max_steps: 1000
    size: 25
    num_agents: 5
    cr: 10

training:
    device: auto
    run_name: test_run_v1
    seed: 42
    module_file: cnn_2conv2linear.py
    restore_from_run: null
    num_episodes: 10000
    target_reward: 10000
    target_reward_patience: 20
    checkpoint_interval: 200
    ppo:
        gamma: 0.90
        lr: 0.0001
        grad_clip: 1.0
        train_batch_size: 10000
        num_epochs: 5
        minibatch_size: 1000
        l2_regularization: 0.0001
        lambda_: 0.90
        entropy_coeff_schedule:
            - [0, 0.01]
            - [5_000_000, 0.01]
            - [15_000_000, 0.005]
            - [22_000_000, 0.00001]
    env_runners:
        num_env_runners: 6
        num_envs_per_env_runner: 1
        rollout_fragment_length: auto
        sample_timeout_s: 120

testing:
    run_name: test_run_v1
    num_episodes_per_map: 10
    seed: 42
    explore: true
    render: true
    checkpoint: final
