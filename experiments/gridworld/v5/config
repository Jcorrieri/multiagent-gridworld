environment:
    env_name: gridworld
    reward_scheme: pure_coverage
    base_station: False
    fov: 8
    max_steps: 1000
    size: 25
    num_agents: 20
    cr: 10

training:
    module_file: dqn_cnn.py 
    gamma: 0.90             
    lr: 0.0001              
    train_batch_size: 128   
    buffer_size: 50000     
    learning_starts: 1000   
    target_network_update_freq: 1500
    epsilon: [
        [0, 1.0], 
        [35_000_000, 0.01],
        [70_000_000, 0.01]
    ]
    num_epochs: 3500
    target_reward: 15000

testing:
    num_episodes_per_map: 10
    seed: 42
    explore: True
    render: False
    model_version: v6
    checkpoint: -1
